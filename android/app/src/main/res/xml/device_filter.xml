<?xml version="1.0" encoding="utf-8"?>
<!--
  USB device filter: lists common UART / TTL converter chips
  so the app is notified when such a device is attached.

  Vendor IDs (decimal):
    0x0403 / 1027  - FTDI (FT232R, FT231X, ...)
    0x1A86 / 6790  - WCH CH340 / CH341
    0x10C4 / 4292  - Silicon Labs CP210x
    0x067B / 1659  - Prolific PL2303
    0x2341 / 9025  - Arduino
    0x16C0 / 5824  - Teensy / various CDC
    0x1366 / 4966  - SEGGER J-Link
    0x0483 / 1155  - STMicroelectronics (STM32 VCP)
-->
<resources>
    <!-- FTDI FT232R UART -->
    <usb-device vendor-id="1027" product-id="24577" />
    <!-- FTDI FT231X -->
    <usb-device vendor-id="1027" product-id="24597" />
    <!-- FTDI FT2232H / FT4232H (dual/quad) -->
    <usb-device vendor-id="1027" product-id="24592" />
    <usb-device vendor-id="1027" product-id="24593" />

    <!-- WCH CH340 / CH341 -->
    <usb-device vendor-id="6790" product-id="29987" />
    <usb-device vendor-id="6790" product-id="29988" />

    <!-- Silicon Labs CP2102 / CP210x -->
    <usb-device vendor-id="4292" product-id="60000" />
    <usb-device vendor-id="4292" product-id="60001" />

    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" product-id="8963" />

    <!-- Arduino (all boards) -->
    <usb-device vendor-id="9025" />

    <!-- Teensyduino -->
    <usb-device vendor-id="5824" product-id="1155" />

    <!-- SEGGER J-Link -->
    <usb-device vendor-id="4966" product-id="261" />

    <!-- STM32 Virtual COM Port -->
    <usb-device vendor-id="1155" product-id="22336" />
</resources>